#mutate
blast %>% 
  mutate(proporcion_identidad = pident / 100 ,
         longitud_kb = length / 1000) %>%
  select(query_id, pident, proporcion_identidad,longitud_kb)

blast %>% 
  mutate(
    supera_90 = pident >= 90,
    etiqueta = if_else(pident >= 90, "90 o más", 
                       "Menos de 90")
  ) %>%
  select(query_id,pident, supera_90, etiqueta)

#case_when
blast %>% 
  mutate(
    grupo_didactico = case_when(
      pident >= 95 ~ "Grupo A",
      pident < 80 ~ " Grupo B",
      TRUE ~ "Grupo C"
    )
  ) %>%
  count(grupo_didactico)
# menor a 80 son 8 

blast %>%
